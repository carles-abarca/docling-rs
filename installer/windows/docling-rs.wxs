<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="docling-rs"
           Version="!(bind.fileVersion.CLI)"
           Manufacturer="docling-rs Contributors"
           Language="1033"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="docling-rs - Native Rust document processing CLI"
             Comments="Document conversion tool supporting PDF, DOCX, XLSX, PPTX, HTML, CSV, and Markdown"/>

    <MajorUpgrade DowngradeErrorMessage="A newer version of docling-rs is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="docling.ico" SourceFile="docling-rs.ico"/>
    <Property Id="ARPPRODUCTICON" Value="docling.ico"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/docling-rs/docling-rs"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/docling-rs/docling-rs"/>

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="docling-rs">
          <Component Id="MainExecutable" Guid="*">
            <File Id="CLI" Source="dist\docling-rs.exe" KeyPath="yes"/>
            <File Id="Pdfium" Source="dist\pdfium.dll"/>

            <!-- Add to PATH -->
            <Environment Id="PATH"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Permanent="no"
                         Part="last"
                         Action="set"
                         System="yes"/>
          </Component>

          <!-- Documentation manual -->
          <Directory Id="ManualFolder" Name="manual">
            <Component Id="Documentation" Guid="*">
              <File Id="ManualIndex" Source="dist\manual\index.html" KeyPath="yes"/>
              <File Id="ManualStyle" Source="dist\manual\style.css"/>
              <File Id="ManualInstall" Source="dist\manual\installation.html"/>
              <File Id="ManualQuickstart" Source="dist\manual\quickstart.html"/>
              <File Id="ManualAPI" Source="dist\manual\api-reference.html"/>
              <File Id="ManualCLI" Source="dist\manual\cli.html"/>
              <File Id="ManualFormats" Source="dist\manual\formats.html"/>
              <File Id="ManualChunking" Source="dist\manual\chunking.html"/>
              <File Id="ManualArch" Source="dist\manual\architecture.html"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu shortcuts -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="docling-rs">
          <Component Id="ApplicationShortcuts" Guid="*">
            <Shortcut Id="UninstallShortcut"
                      Name="Uninstall docling-rs"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]"/>
            <Shortcut Id="ManualShortcut"
                      Name="docling-rs Documentation"
                      Target="[ManualFolder]index.html"
                      Description="Open docling-rs developer manual"/>
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\docling-rs" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- Features -->
    <Feature Id="Complete" Title="docling-rs" Level="1" Description="Document processing CLI tool">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="Documentation"/>
      <ComponentRef Id="ApplicationShortcuts"/>
    </Feature>

    <!-- UI -->
    <UIRef Id="WixUI_Minimal"/>
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf"/>
  </Product>
</Wix>
